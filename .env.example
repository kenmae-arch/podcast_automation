# ============ APIキー(必須) ============
# Gemini API キー: https://aistudio.google.com/apikey で無料取得
GEMINI_API_KEY=your_gemini_api_key_here

# Fish Audio API キー: https://fish.audio で取得
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here

# Groqを使う場合のみ: https://console.groq.com で無料取得
# GROQ_API_KEY=your_groq_api_key_here

# ============ LLM設定 ============
# "gemini" または "groq"
LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile

# ============ TTS設定 ============
# Fish Audioのボイスライブラリで選んだ声のID(任意。未指定ならデフォルト音声)
# FISH_AUDIO_REFERENCE_ID=
# 1リクエストあたりの最大文字数
# TTS_CHUNK_SIZE=1500

# ============ 配信設定 ============
# GitHub Pagesの公開URL(必須。例: https://<username>.github.io/<repo>)
SITE_BASE_URL=https://your-username.github.io/your-repo

# ============ ポッドキャスト情報 ============
PODCAST_TITLE=デイリーAIポッドキャスト
PODCAST_DESCRIPTION=AIが毎日自動生成するニュースポッドキャスト
PODCAST_AUTHOR=AI Podcast Bot
PODCAST_EMAIL=podcast@example.com

# ============ ニュース取得(任意) ============
# カンマ区切りで複数指定可
# NEWS_FEED_URLS=https://news.yahoo.co.jp/rss/topics/top-picks.xml
# MAX_TOPICS=5
